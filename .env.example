# Copy to .env (or run: python3 infrastructure/scripts/init_env.py, which also generates secrets).
# .env is gitignored. Never commit real keys.

# --- mode --------------------------------------------------------------------
# mock   : simulated providers, no API keys, no cost (default)
# local  : Ollama on the host (ollama pull llama3.2:1b qwen2.5:3b qwen2.5:7b)
# hosted : OpenAI + Anthropic (requires the keys below; incurs API cost)
ROUTEFORGE_MODE=mock
# Router artifact for learned routing (must match the mode's model pool), e.g.
# ROUTEFORGE_ROUTER_ARTIFACT_PATH=/app/router_training/artifacts/router-hosted-2026-10-11
ROUTEFORGE_ROUTER_ARTIFACT_PATH=
ROUTEFORGE_DEFAULT_STRATEGY=heuristic

# --- provider credentials (hosted mode) ---------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- gateway secrets (generated by init_env.py) --------------------------------
ROUTEFORGE_API_KEY_PEPPER=
ROUTEFORGE_BOOTSTRAP_ADMIN_KEY=
ROUTEFORGE_BOOTSTRAP_CLIENT_KEY=
POSTGRES_PASSWORD=
ROUTEFORGE_APP_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# --- offline tooling -----------------------------------------------------------
# Hard cap (USD) on paid calls made by data collection, judging and benchmarks.
ROUTEFORGE_PAID_BUDGET_USD=20

# --- optional ------------------------------------------------------------------
# Export traces to Jaeger (observability profile): http://jaeger:4318
ROUTEFORGE_OTEL_EXPORTER_ENDPOINT=
# Langfuse (cloud or self-hosted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Enable fault injection admin API (benchmarks only; never in production)
ROUTEFORGE_FAULT_INJECTION_ENABLED=false
